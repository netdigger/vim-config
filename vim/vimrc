"User Manual
"filetype off                  " required
"

let s:config_dir = expand('~/.vim')

" Plug plugin list
execute 'source ' . s:config_dir . '/config/plug_plugins.vimrc'

" ── Common settings ──
syntax on
filetype plugin indent on
" termguicolors must be set BEFORE :colorscheme, otherwise gruvbox initializes
" against the 256-color palette and looks bland.
" t_8f/t_8b: tmux + xterm-256color terminfo lacks the Tc/RGB capability, so
" without these explicit escape codes termguicolors is a no-op inside tmux.
" See :help xterm-true-color
if has('termguicolors')
    let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
    let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
endif
set termguicolors
set background=dark
silent! colorscheme gruvbox
set autowrite
set autoindent
set number
set tabstop=4
set expandtab
set shiftwidth=4
set softtabstop=4
set noshowmode
set showmatch
set linebreak
set laststatus=2
set hidden
set ignorecase
set smartcase
set updatetime=300
" wildoptions=pum needs Vim >=8.2.4325; jumpoptions=stack needs >=8.2.1497.
silent! set wildoptions=pum
silent! set jumpoptions=stack

highlight Pmenu ctermfg=white ctermbg=darkgray
highlight PmenuSel ctermfg=white ctermbg=darkgreen

let mapleader = " "
set tags=./.tags;,.tags

" ── Window navigation ──
nnoremap <c-h> <c-w><c-h>
nnoremap <c-j> <c-w><c-j>
nnoremap <c-k> <c-w><c-k>
nnoremap <c-l> <c-w><c-l>

" ── Plugin configs ──
execute 'source ' . s:config_dir . '/config/terminal.vimrc'
execute 'source ' . s:config_dir . '/config/git.vimrc'
execute 'source ' . s:config_dir . '/config/asyncrun.vimrc'
execute 'source ' . s:config_dir . '/config/gutentags.vimrc'
execute 'source ' . s:config_dir . '/config/ale.vimrc'
execute 'source ' . s:config_dir . '/config/fzf.vimrc'
execute 'source ' . s:config_dir . '/config/leaderf.vimrc'
execute 'source ' . s:config_dir . '/config/ycm.vimrc'
execute 'source ' . s:config_dir . '/config/airline.vimrc'
execute 'source ' . s:config_dir . '/config/echodoc.vimrc'

" ── Quickfix ──
nnoremap <c-t> :put =strftime('%Y-%m-%dT%H:%M:%S%z')<CR>
inoremap <c-t> <ESC>:put =strftime('%Y-%m-%dT%H:%M:%S%z')<CR>

nnoremap <F8> :cn<CR>
nnoremap <F9> :cp<CR>
nnoremap <F10> :cclose<CR>
inoremap <F8> <ESC>:cn<CR>
inoremap <F9> <ESC>:cp<CR>
inoremap <F10> <ESC>:cclose<CR>

" ── Filetype detection (see ftdetect/ directory) ──

" ── Language/formatting configs ──
execute 'source ' . s:config_dir . '/config/go.vimrc'
execute 'source ' . s:config_dir . '/config/autoformat.vimrc'
